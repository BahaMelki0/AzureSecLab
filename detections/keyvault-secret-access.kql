// AzureDiagnostics schema: diagnostic setting intentionally uses the default destination.
// Replace this value with terraform output -raw identity_principal_id.
let WorkloadObjectId = "REPLACE-WORKLOAD-PRINCIPAL-ID";
AzureDiagnostics
| where TimeGenerated > ago(1h)
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| where OperationName == "SecretGet"
| extend CallerObjectId = tostring(column_ifexists("identity_claim_oid_g", ""))
| where CallerObjectId == WorkloadObjectId
| extend RequestUri = tostring(column_ifexists("requestUri_s", ""))
| where RequestUri has "/secrets/lab-payroll"
| project TimeGenerated, ResourceId, CallerObjectId, OperationName,
          ResultType, ResultSignature, RequestUri, CallerIPAddress
| order by TimeGenerated desc
